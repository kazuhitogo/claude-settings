{
  "permissions": {
    "deny": [
      "Bash(git config *)",
      "Bash(chmod 777 *)",
      "Bash(rm -rf /*)",
      "Bash(gh repo delete:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(pip install *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Read(~/.gcloud/**)",
      "Write(~/.gcloud/**)",
      "Edit(~/.gcloud/**)",
      "Bash(cat ~/.gcloud/*)",
      "Bash(cat ~/.gcloud/**/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/scripts/complete_sound.py",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/deny-check.sh"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "model": "sonnet"
}
